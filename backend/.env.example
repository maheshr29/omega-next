# Backend service env vars.
# Copy to .env (local dev) or set in Vercel UI (Preview/Production).

# --- server ---
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed origins for CORS, or "*" for any.
ALLOWED_ORIGINS=http://localhost:3000

# --- SAP Commerce (OCC) --- (wired in phase 4)
SAP_COMMERCE_BASE_URL=
SAP_COMMERCE_BASE_SITE_ID=
SAP_COMMERCE_TOKEN_URL=
SAP_COMMERCE_CLIENT_ID=
SAP_COMMERCE_CLIENT_SECRET=

# --- Contentful --- (wired in phase 4)
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
CONTENTFUL_USE_PREVIEW=false
CONTENTFUL_HOME_PAGE_ENTRY_ID=

# --- Algolia --- (wired in phase 5)
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_INDEX=

# --- Webhook secrets ---
CONTENTFUL_WEBHOOK_SECRET=
SAP_COMMERCE_WEBHOOK_SECRET=
ALGOLIA_WEBHOOK_SECRET=
