# Frontend env vars.
# Copy to .env.local (local dev) or set in Vercel UI (Preview/Production).

# Backend BFF base URL. Required — the BFF client builds requests against this.
# Local dev: http://localhost:4000
# Vercel Preview/Production: the backend project URL (e.g. https://api.omega.com)
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:4000

# Algolia (added in phase 5; only needed if client-side InstantSearch is enabled)
# NEXT_PUBLIC_ALGOLIA_APP_ID=
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# Frontend log level (used by instrumentation hook)
LOG_LEVEL=info
