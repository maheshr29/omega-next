# ---------- Contentful (CMS) ----------
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
# Set to "true" to read draft content via the Preview API
CONTENTFUL_USE_PREVIEW=false

# Entry IDs for global content fetched outside of slug-based pages.
# Each is the `sys.id` of the corresponding Contentful entry.
CONTENTFUL_HEADER_ENTRY_ID=
CONTENTFUL_FOOTER_ENTRY_ID=
CONTENTFUL_HERO_BANNER_ENTRY_ID=
CONTENTFUL_HELP_SECTION_ENTRY_ID=
CONTENTFUL_INDUSTRY_SECTION_ENTRY_ID=

# Webhook secret — Contentful sets `x-webhook-secret: <this>` on publish events.
CONTENTFUL_WEBHOOK_SECRET=

# ---------- SAP Commerce (OCC REST API) ----------
# Example: https://api.your-sap-host.com/occ/v2
SAP_COMMERCE_BASE_URL=
# Example: apparel-uk, electronics-spa, etc.
SAP_COMMERCE_BASE_SITE_ID=
# OAuth2 token endpoint, usually {host}/authorizationserver/oauth/token
SAP_COMMERCE_TOKEN_URL=
SAP_COMMERCE_CLIENT_ID=
SAP_COMMERCE_CLIENT_SECRET=
# Webhook secret — SAP/PIM sets `x-webhook-secret: <this>` on publish events.
SAP_COMMERCE_WEBHOOK_SECRET=

# Cache TTLs (seconds) used by the BFF — tune per environment.
BFF_PRODUCT_REVALIDATE_SECONDS=60
BFF_CONTENT_REVALIDATE_SECONDS=300

# ---------- BFF client ----------
# Optional. If set, server-side BFF client uses this base URL instead of
# defaulting to http://127.0.0.1:$PORT.
NEXT_PUBLIC_BFF_BASE_URL=

# ---------- Observability ----------
LOG_LEVEL=info
